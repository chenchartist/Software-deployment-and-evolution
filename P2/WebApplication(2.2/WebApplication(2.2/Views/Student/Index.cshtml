@model List<WebApplication2_2.Models.Student>

<div class="container mt-5">
    <h2>Student Registration</h2>

    <a href="/Student/Create" class="btn btn-primary mb-3">Add New Student</a>

    @if (Model.Count == 0)
    {
        <p>No students registered yet.</p>
    }
    else
    {
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Name</th>
                    <th>Email</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var student in Model)
                {
                    <tr>
                        <td>@student.Id</td>
                        <td>@student.Name</td>
                        <td>@student.Email</td>
                        <td>
                            <a href="/Student/Delete/@student.Id" class="btn btn-danger btn-sm">Delete</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>